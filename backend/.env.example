# Application Settings
APP_NAME=AI Compliance Copilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=PleaseGenerateAStrongSecretKeyHere
ACCESS_TOKEN_EXPIRE_MINUTES=1440 
ALGORITHM=HS256

# Database
# Use full connection string
DATABASE_URL=mysql+pymysql://root:rootpassword@db:3306/compliance_copilot
MONGODB_URL=mongodb://mongo:27017

# Redis
REDIS_URL=redis://redis:6379/0

# AI Configuration (Open Source Stack)
# Groq specific (Llama 3 via API)
GROQ_API_KEY=gsk_your_groq_api_key_here
DEFAULT_LLM_MODEL=llama3-70b-8192

# HuggingFace Embeddings (Local/Free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pinecone (Vector Database - Free Tier)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=gcp-starter
PINECONE_INDEX_NAME=compliance-copilot

# Optional: OpenAI (if needed later)
# OPENAI_API_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=no-reply@compliance-copilot.com

# Encryption
ENCRYPTION_KEY=GenerateA32ByteKeyForAES256

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
